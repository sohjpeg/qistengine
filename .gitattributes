# Keep shell scripts LF so they run under bash / WSL2 regardless of checkout OS.
*.sh text eol=lf
bootstrap.sh text eol=lf
run-dev.sh text eol=lf

# Normalise text files to LF in the repo.
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.txt text eol=lf
*.ini text eol=lf

# Binary assets
*.woff2 binary
*.pdf binary
*.png binary
*.jpg binary
*.ico binary
