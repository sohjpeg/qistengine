QIST_ENV=development
QIST_DATABASE_URL=sqlite:///./data/qistengine.db
QIST_MODEL_DIR=./app/ml/artifacts
QIST_CORS_ORIGINS=http://localhost:3000
# Key for encrypting PII at rest (name, CNIC, phone, bill fields, notes).
# Leave blank in development: a published dev key is used and a warning logged.
# REQUIRED when QIST_ENV=production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
QIST_PII_KEY=
QIST_OCR_ENGINE=auto          # auto | tesseract | fallback
QIST_MAX_UPLOAD_MB=10
QIST_SEED=42
