# Root env example. bootstrap.sh copies backend/.env.example and frontend/.env.local.example
# to their live names. This file documents the full set in one place.

# --- Backend ---
QIST_ENV=development
QIST_DATABASE_URL=sqlite:///./data/qistengine.db
QIST_MODEL_DIR=./app/ml/artifacts
QIST_CORS_ORIGINS=http://localhost:3000
QIST_OCR_ENGINE=auto          # auto | tesseract | fallback
QIST_MAX_UPLOAD_MB=10
QIST_SEED=42

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
